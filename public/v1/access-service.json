{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hackfed.org/v1/access-service.json",
  "type": "object",
  "properties": {
    "maintainers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "github"
              },
              "username": {
                "type": "string",
                "description": "Username for GitHub type maintainers"
              }
            },
            "required": [
              "type",
              "username"
            ],
            "additionalProperties": false,
            "description": "Maintainer identified by GitHub username"
          },
          {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Email address for email type maintainers"
              },
              "type": {
                "type": "string",
                "const": "email"
              }
            },
            "required": [
              "email",
              "type"
            ],
            "additionalProperties": false,
            "description": "Maintainer identified by email address"
          }
        ]
      },
      "description": "List of organization maintainers"
    }
  },
  "additionalProperties": false,
  "description": "Access control and maintainer information for an organization",
  "id": "AccessService",
  "title": "Organization Access Service"
}